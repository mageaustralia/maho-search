<?xml version="1.0"?>
<config>
    <modules>
        <MageAustralia_LuceneSearch>
            <version>1.0.0</version>
        </MageAustralia_LuceneSearch>
    </modules>

    <global>
        <models>
            <lucenesearch>
                <class>MageAustralia_LuceneSearch_Model</class>
            </lucenesearch>
            <catalogsearch_resource>
                <rewrite>
                    <fulltext>MageAustralia_LuceneSearch_Model_Resource_CatalogSearch_Fulltext</fulltext>
                </rewrite>
            </catalogsearch_resource>
        </models>
        <helpers>
            <lucenesearch>
                <class>MageAustralia_LuceneSearch_Helper</class>
            </lucenesearch>
        </helpers>
        <blocks>
            <lucenesearch>
                <class>MageAustralia_LuceneSearch_Block</class>
            </lucenesearch>
        </blocks>
    </global>

    <default>
        <lucenesearch>
            <general>
                <enabled>1</enabled>
                <index_path>var/lucene</index_path>
            </general>
            <products>
                <enabled>1</enabled>
                <searchable_attributes>name,sku,description,short_description</searchable_attributes>
                <boost_name>3.0</boost_name>
                <boost_sku>2.0</boost_sku>
                <boost_description>1.0</boost_description>
                <boost_short_description>1.5</boost_short_description>
                <index_category_paths>1</index_category_paths>
                <boost_category_paths>1.5</boost_category_paths>
            </products>
            <categories>
                <enabled>1</enabled>
                <searchable_attributes>name,description,meta_title,meta_keywords,meta_description</searchable_attributes>
                <boost_name>3.0</boost_name>
                <boost_description>1.5</boost_description>
                <boost_meta_title>2.0</boost_meta_title>
                <boost_meta_keywords>1.5</boost_meta_keywords>
                <boost_meta_description>1.0</boost_meta_description>
            </categories>
            <cms>
                <enabled>1</enabled>
                <searchable_attributes>title,content,content_heading,meta_keywords,meta_description</searchable_attributes>
                <excluded_pages>no-route,enable-cookies</excluded_pages>
                <boost_title>3.0</boost_title>
                <boost_content>1.0</boost_content>
                <boost_content_heading>2.5</boost_content_heading>
                <boost_meta_keywords>1.5</boost_meta_keywords>
                <boost_meta_description>1.0</boost_meta_description>
            </cms>
            <search>
                <result_limit>500</result_limit>
                <suggest_limit>10</suggest_limit>
                <fuzzy_fallback>1</fuzzy_fallback>
                <similarity>tfidf</similarity>
                <bm25_k1>1.2</bm25_k1>
                <bm25_b>0.75</bm25_b>
                <bm25_avg_field_length>10</bm25_avg_field_length>
                <synonyms></synonyms>
            </search>
        </lucenesearch>
    </default>
</config>
